{
  "expo": {
    "name": "MoveMaxx",
    "slug": "mobile",
    "version": "1.2.0",
    "scheme": "movemaxx",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.sohan.bulletproof",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Choose photos to add to your workouts and profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "MoveMaxx doesn't read your Health data.",
          "NSHealthUpdateUsageDescription": "MoveMaxx saves your finished workouts to Apple Health when you turn this on in Settings.",
          "background": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WorkoutActivity",
              "displayName": "Workout",
              "description": "Shows the current in-progress workout on the lock screen / Dynamic Island.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#0B0C0F",
          "resizeMode": "contain"
        }
      ],
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }]
    ],
    "extra": {
      "eas": {
        "projectId": "e33508b8-cbaf-4e38-a565-25125d749a0e"
      }
    },
    "owner": "smadimsetty"
  }
}
